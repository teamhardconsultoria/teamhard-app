{
  "expo": {
    "name": "Método Acelera!",
    "slug": "teamhard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "teamhard",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teamhard.app",
      "buildNumber": "1"
    },
    "android": {
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.teamhard.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E8FF00"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Método Acelera! precisa da câmera para fotos de avaliação."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Método Acelera! precisa acessar suas fotos para envio de avaliações."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Método Acelera! precisa salvar imagens na sua galeria.",
          "savePhotosPermission": "Método Acelera! precisa salvar imagens na sua galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9055d51d-d07f-426e-ba44-1d34a1373580"
      }
    },
    "owner": "teamhard"
  }
}
